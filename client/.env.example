# Leave empty in dev — Vite proxies /api to http://localhost:5000 (see vite.config.js).
# Set to your deployed backend URL in production.
VITE_API_URL=

# Public Razorpay key (safe for the browser — never put the secret here).
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# Firebase client config (all public values, safe for the browser).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=


VITE_DEMO_MERCHANT_ID=